# usage-monitor credential overrides
# Copy to: ~/.config/usage-monitor/env   (highest priority; all keys optional)
#
# If a key is absent here, credentials are auto-reused from local agent CLIs:
#   DeepSeek / GLM / MiniMax -> ~/.local/share/opencode/auth.json or ~/.hermes/auth.json
#   Claude                   -> macOS Keychain "Claude Code-credentials" (Claude Code login)
#   Codex / Spark            -> ~/.codex/auth.json (codex CLI login; auto-refreshed).
#                                Spark is a separate quota pool on the same account.
#   Grok                     -> ~/.grok/auth.json (grok login; auto-refreshed)
#   Gemini                   -> ~/.gemini/oauth_creds.json (gemini CLI login; auto-refreshed)
#   Qoder                    -> no local credential to reuse (qodercn's ~/.qoder-cn/.auth
#                              is WASM-encrypted); generate a Personal Access Token at
#                              qoder.com.cn → Account Settings → Integrations and set QODER_PAT.
#
# Providers with no credentials anywhere are simply hidden from the panel.

# Custom usage endpoint (any local gateway / dashboard exposing one JSON number).
# CUSTOM_USAGE_PATH picks a nested field ("data.percent"); a number 0-100 is
# taken as the percentage, {"used":u,"total":t} is converted automatically.
#CUSTOM_USAGE_URL=https://one-api.local/api/usage
#CUSTOM_USAGE_TOKEN=sk-xxxx
#CUSTOM_USAGE_PATH=data.percent
#CUSTOM_NAME=OneAPI
#CUSTOM_LABEL=mo

#DEEPSEEK_API_KEY=sk-xxxx
#GLM_API_KEY=xxxx
#MINIMAX_API_KEY=xxxx
# Qoder Personal Access Token (also honored from the QODERCN_/QODER_PERSONAL_ACCESS_TOKEN
# process env). The exchanged access token is cached in state.json and refreshed there.
#QODER_PAT=qpm_xxxx
# International (qoder.sh) instead of China (qoder.com.cn) openapi host:
#QODER_OPENAPI=https://openapi.qoder.sh
